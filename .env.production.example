# STAYSCAPE production environment template for docker-compose.prod.yml (docs/deployment.md).
# Copy to .env.production ON THE DEPLOY HOST (never commit it) and fill every value from your
# secret manager. The API refuses to start on missing or development values.

STACK_NAME=prod
DEPLOYMENT_ENV=production
PUBLIC_URL=https://www.example.com
WEB_BIND=10.0.0.10:8080
REGISTRY=ghcr.io/your-org/stayscape
IMAGE_TAG=sha-0000000000000

# Managed services (private networking only; never publicly reachable)
MONGO_URI=mongodb+srv://stayscape-app:<password>@cluster.example.mongodb.net/stayscape?retryWrites=true&w=majority
REDIS_URL=rediss://default:<password>@redis.example.com:6379

# Secrets (generate: node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))")
JWT_ACCESS_SECRET=
DATA_ENCRYPTION_KEY=
QUOTE_SIGNING_SECRET=
METRICS_TOKEN=

# Payments: Razorpay LIVE keys (KYC-approved account) — the sandbox is refused in production
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email (transactional SMTP provider with SPF/DKIM/DMARC configured for the sending domain)
MAIL_FROM=STAYSCAPE <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Media: S3-compatible storage (public bucket for listing photos, private bucket for documents)
STORAGE_DRIVER=s3
S3_BUCKET=
S3_PRIVATE_BUCKET=
S3_REGION=ap-south-1
S3_PUBLIC_BASE_URL=https://media.example.com

# Invoices: PROPERTY (each property invoices its guests) or PLATFORM (needs a registered address/GSTIN)
INVOICE_ISSUER_MODE=PROPERTY

# Optional: Claude API for the travel assistant (otherwise the deterministic assistant is used)
AI_PROVIDER=rules
ANTHROPIC_API_KEY=

# Backups (docs/backup-recovery.md)
BACKUP_MONGO_URI=
BACKUP_PASSPHRASE=
BACKUP_RETENTION_DAYS=14

LOG_LEVEL=info
API_DOCS_ENABLED=false
