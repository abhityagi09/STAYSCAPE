# =============================================================================
# STAYSCAPE — environment configuration
# Copy to `.env` at the repository root:  cp .env.example .env
# Values below are SAFE LOCAL DEVELOPMENT DEFAULTS. Never use them in production.
# The API validates every variable at startup and refuses to boot if one is invalid.
# =============================================================================

# ---- Runtime ---------------------------------------------------------------
# NODE_ENV is intentionally NOT set here: this file is shared with Vite, which would apply it to
# production web builds (shipping React's development build). The API defaults to development;
# set NODE_ENV in the process environment for production/test runs.
# local | staging | production. 'staging' = production safeguards plus the labelled sandbox gateway.
DEPLOYMENT_ENV=local
APP_NAME=STAYSCAPE
APP_VERSION=0.1.0
PORT=4000
HOST=0.0.0.0
# Public URL of the API (used in the OpenAPI document and CSRF origin checks)
API_PUBLIC_URL=http://localhost:4000
# Public URL of the web app (used in email links; always on the CORS allowlist)
WEB_APP_URL=http://localhost:5173
# Additional comma-separated CORS origins. REQUIRED in production.
CORS_ORIGINS=http://localhost:5173
# Number of trusted reverse-proxy hops in front of the API (0 when none)
TRUST_PROXY=0
REQUEST_BODY_LIMIT=100kb

# ---- MongoDB (must be a replica set — transactions are required) -------------
# Local Docker:  npm run services:up
MONGO_URI=mongodb://localhost:27017/stayscape?directConnection=true
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000

# ---- Redis (rate limiting + BullMQ job queues) ------------------------------
REDIS_URL=redis://localhost:6379

# ---- Authentication ---------------------------------------------------------
# >= 32 characters. Generate a real one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Values containing "dev-only" are rejected when NODE_ENV=production.
JWT_ACCESS_SECRET=dev-only-change-me-0123456789abcdefghijklmnopqrstuvwxyz
JWT_ISSUER=stayscape-api
JWT_AUDIENCE=stayscape-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Secure cookies require HTTPS. `false` is only acceptable on http://localhost.
COOKIE_SECURE=false
# strict | lax  (strict recommended when web and API share a site)
COOKIE_SAMESITE=strict
# Leave empty for host-only cookies
COOKIE_DOMAIN=
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30
# Argon2id cost (OWASP minimum: 19 MiB memory, 2 iterations)
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2

# ---- Marketplace -----------------------------------------------------------
# AES-256-GCM key material for sensitive fields (settlement account numbers). >= 32 chars.
DATA_ENCRYPTION_KEY=dev-only-data-key-0123456789abcdefghijklmnopqrstuvwxyz
# HMAC secret that signs price quotes so they can be revalidated before booking. >= 32 chars.
QUOTE_SIGNING_SECRET=dev-only-quote-secret-0123456789abcdefghijklmnopqrstuv
QUOTE_TTL_SECONDS=900
# Cache TTL for non-transactional public data (destinations, featured). Availability is never cached.
SEARCH_CACHE_TTL_SECONDS=60
# Priced search listings only (re-quoted on the property page and at hold time); 0 disables, max 60
PRICED_SEARCH_CACHE_TTL_SECONDS=15
# Unattached uploads older than this are removed by the cleanup job
MEDIA_ORPHAN_TTL_HOURS=24
# Password for development seed accounts (npm run seed). Required to run the seed.
SEED_USER_PASSWORD=

# ---- Email ------------------------------------------------------------------
# smtp   — real SMTP delivery (local default points at Mailpit, which captures mail)
# log    — DEV ONLY: write emails to the API log instead of sending
# memory — TEST ONLY
MAIL_PROVIDER=smtp
MAIL_FROM="STAYSCAPE <no-reply@stayscape.local>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# ---- Media storage ----------------------------------------------------------
# local — files under UPLOAD_DIR served at MEDIA_PUBLIC_BASE_URL (dev / single node)
# s3    — any S3-compatible store (AWS S3, Cloudflare R2, MinIO...)
STORAGE_DRIVER=local
UPLOAD_DIR=./var/uploads
# Private (never publicly served) storage for verification documents
PRIVATE_UPLOAD_DIR=./var/private
S3_PRIVATE_BUCKET=
MEDIA_PUBLIC_BASE_URL=/api/v1/media
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=false

# ---- Rate limiting (per IP, per window) -------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=20

# ---- Operations -------------------------------------------------------------
# Run BullMQ workers inside the API process (set false when running `worker` separately)
RUN_WORKERS=true
LOG_LEVEL=info
LOG_PRETTY=true
API_DOCS_ENABLED=true
# Bearer token for GET /metrics (Prometheus, private network only). Leave empty to disable.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
METRICS_TOKEN=

# ---- Web (Vite) -------------------------------------------------------------
# Map style (MapLibre). Default: OpenFreeMap (no key). For Mapbox use
# https://api.mapbox.com/styles/v1/mapbox/streets-v12?access_token=YOUR_TOKEN
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Same-origin path in development (Vite proxies /api to the API)
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://localhost:4000

# ---- Development-only administrator bootstrap (npm run bootstrap:admin) --------
# Refuses to run when NODE_ENV=production or against a non-local database.
ADMIN_BOOTSTRAP_EMAIL=admin@stayscape.local
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_FIRST_NAME=Platform
ADMIN_BOOTSTRAP_LAST_NAME=Admin

# ---- End-to-end tests ---------------------------------------------------------
E2E_BASE_URL=
MAILPIT_URL=http://localhost:8025

# ---- Reservations & payments (Phase 3) ----------------------------------------
# Minutes rooms stay held while the guest completes checkout (inventory is reserved atomically).
BOOKING_HOLD_TTL_MINUTES=10
# sandbox = labelled local/test gateway (no money moves; refused in production). razorpay = real gateway.
PAYMENT_PROVIDER=sandbox
# Razorpay test-mode keys (Dashboard → Settings → API Keys) and the webhook secret you set on
# Dashboard → Settings → Webhooks for https://<api-host>/api/v1/payments/webhooks/razorpay
# (events: payment.captured, payment.failed, order.paid, refund.processed, refund.failed).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_API_BASE=https://api.razorpay.com/v1
# HMAC secret of the sandbox gateway (development/test only). >= 32 chars.
SANDBOX_PAYMENT_SECRET=dev-only-sandbox-gateway-secret-0123456789abcdef
PAYMENT_MERCHANT_NAME=STAYSCAPE
# Who issues guest invoices: PLATFORM (merchant of record, details below) or PROPERTY (partner's details).
INVOICE_ISSUER_MODE=PLATFORM
INVOICE_ISSUER_NAME=STAYSCAPE Travel (development)
INVOICE_ISSUER_ADDRESS=Not configured — set INVOICE_ISSUER_ADDRESS
INVOICE_ISSUER_TAX_ID=
INVOICE_ISSUER_EMAIL=billing@stayscape.local
INVOICE_NUMBER_PREFIX=SSI
# Reviews: edit window and maximum number of edits.
REVIEW_EDIT_WINDOW_DAYS=30
REVIEW_MAX_EDITS=3
# Optional address that receives operations alerts (reconciliation, failed refunds).
OPS_ALERT_EMAIL=

# ---------------------------------------------------------------- Phase 4: finance
# Commission when no rule applies, in basis points (1500 = 15%). Rules are managed in /admin/commissions.
COMMISSION_DEFAULT_BASIS_POINTS=1500
# Days after check-out before a stay's partner payable can be settled.
SETTLEMENT_HOLD_DAYS=1
# Automated payouts stay disabled until a payout provider is onboarded (only "disabled" is accepted).
PAYOUT_PROVIDER=disabled

# ---------------------------------------------------------------- Phase 4: currency display
# ecb: European Central Bank daily reference rates (display-only conversions); disabled: none.
FX_PROVIDER=ecb

# ---------------------------------------------------------------- Phase 4: AI travel assistant
# rules: deterministic no-AI assistant (development/test). anthropic: Claude via the official SDK.
AI_PROVIDER=rules
# Server-side only; never exposed to the browser. Required when AI_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=low
AI_REQUEST_TIMEOUT_MS=30000
AI_TURN_DEADLINE_MS=60000
AI_MAX_TOOL_ITERATIONS=4
AI_MAX_OUTPUT_TOKENS=4000
AI_DAILY_REQUESTS_PER_USER=50
AI_REQUESTS_PER_MINUTE_PER_USER=6
# Monthly spend cap in micro-USD (0 = no cap); beyond it the deterministic assistant answers.
AI_MONTHLY_BUDGET_MICRO_USD=0
# Published per-million-token prices in USD, used for cost tracking (defaults: claude-opus-5-5).
AI_PRICE_INPUT_PER_MTOK=4
AI_PRICE_OUTPUT_PER_MTOK=20
AI_PRICE_CACHE_READ_PER_MTOK=0.2
